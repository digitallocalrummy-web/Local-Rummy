# Copy to .env and edit. Never commit .env.
# For testing on your own computer you don't need a .env at all: the defaults below are used.

PORT=4000

# Database:
#   pglite:.data/localrummy  → built-in database saved in apps/server/.data (testing only, nothing to install)
#   postgres://USER:PASSWORD@localhost:5432/localrummy  → real PostgreSQL (use this on the VPS)
DATABASE_URL=pglite:.data/localrummy

# Long random strings in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-player-secret
ADMIN_JWT_SECRET=change-me-admin-secret

# Comma-separated addresses allowed to open the admin panel (browser origin)
CORS_ORIGINS=http://localhost:5173

# First super admin, created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@localrummy.app
SEED_ADMIN_PASSWORD=change-me-now
