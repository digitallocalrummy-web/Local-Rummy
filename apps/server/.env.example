# Copy to .env and fill in real values. Never commit .env.
PORT=4000
DATABASE_URL=postgres://localrummy:localrummy@localhost:5432/localrummy
# Long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me-too
# Comma-separated origins allowed to call the API (admin site, Expo web)
CORS_ORIGINS=http://localhost:5173
# First super admin, created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@localrummy.app
SEED_ADMIN_PASSWORD=change-me-now
