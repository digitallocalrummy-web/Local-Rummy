{
  "name": "@local-rummy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsup src/index.ts src/seed.ts --format esm --platform node --target node22 --out-dir dist --clean --noExternal @local-rummy/rummy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/migrate.ts",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "test": "DATABASE_URL=postgres://test JWT_SECRET=test-secret ADMIN_JWT_SECRET=test-secret node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@local-rummy/rummy": "workspace:*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
